# Cloud Cost Firewall - Environment Configuration
# Copy this file to .env and edit as needed.

# --- Provider (change these to switch AI provider) ---
UPSTREAM_URL=http://localhost:9000/v1/chat/completions
UPSTREAM_KEY=

# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# Groq:    https://api.groq.com/openai/v1/chat/completions
# OpenAI:  https://api.openai.com/v1/chat/completions
# Ollama:  http://localhost:11434/v1/chat/completions

# --- Infrastructure ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://firewall:firewall@localhost:5432/firewall

# --- Telegram (optional, both must be set to enable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Advanced ---
# Some providers use max_completion_tokens instead of max_tokens (e.g. newer OpenAI models).
# Uncomment the line below if you get a 400 error about max_tokens.
# MAX_TOKENS_FIELD=max_completion_tokens
MAX_TOKENS_FIELD=max_tokens
